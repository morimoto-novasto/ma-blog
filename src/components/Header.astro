---
interface Props {
  current?: 'home' | 'notes' | 'explore' | 'about';
}

const { current } = Astro.props;
---

<header class="site-header site-chrome" data-site-header>
  <div class="shell site-header__inner">
    <a class="brand" href="/" aria-label="間 ma ホーム">
      <span class="brand__mark">間</span>
      <span class="brand__sub">ma · notes</span>
    </a>
    <nav class="nav" aria-label="主要ナビ">
      <a href="/" aria-current={current === 'home' ? 'page' : undefined}>Home</a>
      <a href="/notes" aria-current={current === 'notes' ? 'page' : undefined}>Notes</a>
      <a href="/explore" aria-current={current === 'explore' ? 'page' : undefined}>Explore</a>
      <a href="/about" aria-current={current === 'about' ? 'page' : undefined}>About</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 12);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
