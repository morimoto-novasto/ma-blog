---
import type { Note } from '../lib/posts';
import { formatDate } from '../lib/posts';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
---

<div class="timeline" role="list">
  {
    notes.map((note) => (
      <article class="timeline__row" role="listitem">
        <div class="timeline__dot" aria-hidden="true" />
        <div>
          <div class="timeline__meta">
            <time datetime={note.data.publishedAt.toISOString()}>
              {formatDate(note.data.publishedAt)}
            </time>
            <span class="mood">{note.data.mood}</span>
          </div>
          <h3 class="timeline__title">
            <a href={`/notes/${note.id}`}>{note.data.title}</a>
          </h3>
          <p class="timeline__desc">{note.data.description}</p>
        </div>
      </article>
    ))
  }
</div>
