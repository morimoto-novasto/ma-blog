---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExploreGarden from '../components/ExploreGarden';
import { getPublishedNotes, toNoteCard } from '../lib/posts';

const notes = (await getPublishedNotes()).map(toNoteCard);
---

<BaseLayout
  title="Explore"
  description="ムードとタグで思考を散策する庭。TanStack Query で即応フィルタ。"
>
  <Header current="explore" />
  <main class="shell explore-shell">
    <p class="eyebrow">explore</p>
    <h1 class="display" style="margin:0.5rem 0 0.6rem;font-size:clamp(2rem,4vw,2.8rem);">
      散策の庭
    </h1>
    <p style="color:var(--ink-mute);max-width:36rem;margin:0 0 1.75rem;">
      関連だけでなく、あえてムードの違うノートも混ぜます。
      教育心理学の interleaved practice（対照による弁別）を、個人サイトの発見体験へ翻訳したものです。
    </p>
    <ExploreGarden client:only="react" initial={notes} />
  </main>
  <Footer />
</BaseLayout>
